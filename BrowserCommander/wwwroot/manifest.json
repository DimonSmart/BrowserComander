{
  "manifest_version": 3,
  "name": "BrowserComander Extension",
  "description": "My browser extension built with Blazor WebAssembly",
  "version": "0.1.2",
  "background": {
    "service_worker": "background-agent.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "debugger",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [ "*://*/*" ],
      "js": [ "injectedScript.js" ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "framework/*",
        "content/*",
        "background-agent.js",
        "injectedScript.js"
      ],
      "matches": [ "<all_urls>" ]
    }
  ]
}
