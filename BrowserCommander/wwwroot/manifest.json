{
  "manifest_version": 3,
  "name": "BrowserCommander",
  "short_name": "BrowserCommander",
  "description": "Local-first browser automation extension for authorized Chromium tabs connected to a local MCP server.",
  "version": "0.1.2",
  "icons": {
    "16": "icons/browsercommander-16.png",
    "32": "icons/browsercommander-32.png",
    "48": "icons/browsercommander-48.png",
    "128": "icons/browsercommander-128.png"
  },
  "background": {
    "service_worker": "background-agent.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "BrowserCommander",
    "default_icon": {
      "16": "icons/browsercommander-16.png",
      "32": "icons/browsercommander-32.png"
    }
  },
  "permissions": [
    "activeTab",
    "debugger",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [ "*://*/*" ],
      "js": [ "injectedScript.js" ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "framework/*",
        "content/*",
        "background-agent.js",
        "injectedScript.js"
      ],
      "matches": [ "<all_urls>" ]
    }
  ]
}
