@page "/popup.html"
@using BrowserCommander.Contracts
@inherits BasePage
@using WebExtensions.Net.Runtime

<div class="popup-container">
    <header class="popup-header">
        <h1>BrowserCommander</h1>
        <span class="popup-connection @(backgroundConnected ? "is-ok" : "is-off")">@connectionStatus</span>
    </header>

    <div class="popup-overview">
        <span>Sync: <strong>@syncStatus</strong></span>
        <span>Authorized: <strong>@authorizedTabs.Count / 64</strong></span>
    </div>

    @if (!string.IsNullOrWhiteSpace(connectionError))
    {
        <div class="popup-error" role="alert">@connectionError</div>
    }

    <section class="popup-current" aria-label="Current tab">
        <div class="popup-section-label">Current tab</div>
        <div class="popup-tab-heading">
            @if (activeTabId.HasValue)
            {
                <span class="popup-tab-id">#@activeTabId</span>
            }
            <span class="popup-truncate" title="@currentTabTitle">@currentTabTitle</span>
        </div>
        @if (!string.IsNullOrWhiteSpace(currentTabUrl))
        {
            <div class="popup-tab-url" title="@currentTabUrl">@currentTabUrl</div>
        }
        <div class="popup-access-row">
            <span class="popup-access @(activeTabAuthorized ? "is-ok" : "is-off")">
                Local: @(activeTabAuthorized ? "Authorized" : "Not authorized")
            </span>
            <span class="popup-access @(activeTabAuthorized && syncStatus == "Synced" && backgroundConnected ? "is-ok" : "is-muted")">
                MCP: @(activeTabAuthorized && syncStatus == "Synced" && backgroundConnected ? "Available" : "Unavailable")
            </span>
        </div>
        <div class="popup-actions">
            @if (activeTabAuthorized)
            {
                <button type="button" class="popup-button popup-button-secondary" @onclick="RevokeCurrentTabAsync" disabled="@(!activeTabId.HasValue)">Revoke access</button>
            }
            else
            {
                <button type="button" class="popup-button popup-button-primary" @onclick="AuthorizeCurrentTabAsync" disabled="@(!activeTabId.HasValue)">Authorize tab</button>
            }
        </div>
    </section>

    <details class="popup-disclosure">
        <summary><span>Authorized tabs in this browser</span><span class="popup-count">@authorizedTabs.Count / 64</span></summary>
        <div class="popup-disclosure-body">
            @if (authorizedTabs.Count == 0)
            {
                <p class="popup-empty">No authorized tabs.</p>
            }
            else
            {
                <div class="popup-list">
                    @foreach (var tab in authorizedTabs)
                    {
                        <div class="popup-list-item" title="@tab.Title">
                            <span class="popup-tab-id">#@tab.TabId</span>
                            <span class="popup-truncate">@tab.Title</span>
                        </div>
                    }
                </div>
            }
            <button type="button" class="popup-clear-button" @onclick="ClearAuthorizedTabsAsync" disabled="@(authorizedTabs.Count == 0)">Clear tabs in this browser</button>
        </div>
    </details>

    <details class="popup-disclosure">
        <summary><span>Pages available through MCP</span><span class="popup-count">@globalTabCount</span></summary>
        <div class="popup-disclosure-body">
            @if (!string.IsNullOrWhiteSpace(globalPagesError))
            {
                <p class="popup-error" role="alert">@globalPagesError</p>
            }
            else if (globalPages.Count == 0)
            {
                <p class="popup-empty">No pages are currently available through MCP.</p>
            }
            else
            {
                <div class="popup-list">
                    @foreach (var tab in globalPages)
                    {
                        var isLocal = string.Equals(tab.AgentId, agentId, StringComparison.Ordinal);
                        var isActive = isLocal && activeTabId.HasValue && tab.TabId == activeTabId.Value;
                        var browserLabel = isLocal ? "This browser" : (tab.BrowserName ?? tab.AgentId);
                        <div class="popup-page-item">
                            <div class="popup-page-heading">
                                <span class="popup-tab-id">#@tab.TabId</span>
                                <span class="popup-truncate" title="@tab.Title">@tab.Title</span>
                                @if (isActive)
                                {
                                    <span class="popup-page-origin">Current</span>
                                }
                            </div>
                            <div class="popup-page-meta">
                                <span class="popup-truncate" title="@tab.Url">@tab.Url</span>
                                <span class="popup-page-origin" title="@browserLabel">@browserLabel</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </details>

    <details class="popup-disclosure">
        <summary><span>Connection details</span><span class="popup-count">@syncStatus</span></summary>
        <dl class="popup-details">
            <dt>Server</dt><dd title="@serverAddress">@serverAddress</dd>
            <dt>Agent ID</dt><dd title="@agentId">@agentId</dd>
            <dt>Connection</dt><dd>@connectionStatus</dd>
            <dt>Revision / ACK</dt><dd>@localRevision / @ackRevision</dd>
        </dl>
    </details>
</div>

@code {
    [Inject] JSInteropService JSInteropService { get; set; } = default!;

    private string connectionError { get; set; } = string.Empty;
    private string serverAddress { get; set; } = "Loading...";
    private string agentId { get; set; } = string.Empty;
    private bool backgroundConnected { get; set; }
    private string connectionStatus { get; set; } = "Disconnected";
    private string syncStatus { get; set; } = "Pending";
    private long localRevision { get; set; }
    private long ackRevision { get; set; } = -1;
    private int? activeTabId;
    private string currentTabTitle { get; set; } = "No active tab.";
    private string currentTabUrl { get; set; } = string.Empty;
    private bool activeTabAuthorized { get; set; }
    private List<BrowserTabDescriptor> authorizedTabs { get; set; } = [];
    private List<GlobalPageInfo> globalPages { get; set; } = [];
    private string globalPagesError { get; set; } = string.Empty;
    private int globalTabCount => globalPages.Count;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await RefreshServerAddressAsync();
        await RefreshActiveTabAsync();
        await RefreshBackgroundStatusAsync();
        await RefreshGlobalPagesAsync();
    }

    private async Task RefreshServerAddressAsync()
    {
        try
        {
            var settings = await JSInteropService.GetExtensionSettingsAsync();
            serverAddress = settings?.ServerAddress ?? string.Empty;
        }
        catch (Exception ex)
        {
            serverAddress = "Unavailable";
            AppendError("Failed to read server settings: " + ex.Message);
        }
    }

    private async Task RefreshActiveTabAsync()
    {
        var activeTab = (await WebExtensions.Tabs.Query(new()
        {
            Active = true,
            CurrentWindow = true
        })).SingleOrDefault();

        activeTabId = activeTab?.Id;

        if (!activeTabId.HasValue)
        {
            currentTabTitle = "No active tab.";
            currentTabUrl = string.Empty;
            activeTabAuthorized = false;
            return;
        }

        currentTabTitle = string.IsNullOrWhiteSpace(activeTab?.Title) ? "Untitled tab" : activeTab.Title;
        currentTabUrl = activeTab?.Url ?? string.Empty;
        UpdateActiveTabAuthorizationState();
    }

    private async Task RefreshBackgroundStatusAsync()
    {
        var status = await JSInteropService.GetBackgroundAgentStatusAsync();
        ApplyBackgroundStatus(status);
    }

    private async Task RefreshGlobalPagesAsync()
    {
        try
        {
            var result = await JSInteropService.GetGlobalPagesAsync();
            if (result is null || !result.Ok)
            {
                globalPagesError = result?.Error ?? "Failed to load global pages.";
                globalPages = [];
                return;
            }

            globalPagesError = string.Empty;
            globalPages = result.Pages ?? [];
        }
        catch (Exception ex)
        {
            globalPagesError = "Failed to load global pages: " + ex.Message;
            globalPages = [];
        }
    }

    private async Task AuthorizeCurrentTabAsync()
    {
        if (!activeTabId.HasValue)
        {
            AppendError("No active tab is available.");
            return;
        }

        var status = await JSInteropService.AuthorizeTabAsync(activeTabId.Value);
        ApplyBackgroundStatus(status);
        await RefreshGlobalPagesAsync();
    }

    private async Task RevokeCurrentTabAsync()
    {
        if (!activeTabId.HasValue)
        {
            AppendError("No active tab is available.");
            return;
        }

        var status = await JSInteropService.RevokeTabAsync(activeTabId.Value);
        ApplyBackgroundStatus(status);
        await RefreshGlobalPagesAsync();
    }

    private async Task ClearAuthorizedTabsAsync()
    {
        var status = await JSInteropService.ClearAuthorizedTabsAsync();
        ApplyBackgroundStatus(status);
        await RefreshGlobalPagesAsync();
    }

    private void ApplyBackgroundStatus(BackgroundAgentStatus? status)
    {
        if (status is null)
        {
            backgroundConnected = false;
            agentId = string.Empty;
            authorizedTabs = [];
            AppendError("Background agent did not respond.");
            UpdateActiveTabAuthorizationState();
            return;
        }

        backgroundConnected = status.Ok && status.Connected;
        agentId = status.AgentId;
        connectionStatus = status.ConnectionStatus;
        syncStatus = status.SyncStatus;
        localRevision = status.StateRevision;
        ackRevision = status.LastAcknowledgedRevision;
        authorizedTabs = status.AllowedTabs ?? [];

        UpdateActiveTabAuthorizationState();

        if (!status.Ok && !string.IsNullOrWhiteSpace(status.Error))
        {
            AppendError(status.Error);
        }
    }

    private void UpdateActiveTabAuthorizationState()
    {
        activeTabAuthorized = activeTabId.HasValue
            && authorizedTabs.Any(tab => tab.TabId == activeTabId.Value);
    }

    private void AppendError(string message)
    {
        if (string.IsNullOrWhiteSpace(message))
        {
            return;
        }

        connectionError = string.IsNullOrWhiteSpace(connectionError)
            ? message
            : $"{connectionError} {message}";
    }
}
