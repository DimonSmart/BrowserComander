@page "/popup.html"
@using BrowserCommander.Contracts
@inherits BasePage
@using WebExtensions.Net.Runtime

<div class="popup-container">
    <h1 class="popup-header">BrowserCommander</h1>
    <p>Server Address: @serverAddress</p>
    <p>Agent Id: @agentId</p>
    <p>Server connection: @connectionStatus</p>
    <p>Registration / sync: @syncStatus (local rev @localRevision, ACK @ackRevision)</p>
    <p>Authorized tabs in this browser: @authorizedTabs.Count / 64</p>

    @if (!string.IsNullOrEmpty(connectionError))
    {
        <div class="error-message">
            <p>@connectionError</p>
        </div>
    }

    <hr style="width: 100%; margin: 20px 0;" />

    <div class="popup-form">
        <label>Current Tab:</label>
        <textarea readonly class="styled-input" style="height: 70px;">@currentTabSummary</textarea>
        <p>Local access: @(activeTabAuthorized ? "Authorized locally" : "Not authorized")</p>
        <p>MCP access: @(activeTabAuthorized && syncStatus == "Synced" && backgroundConnected ? "Available" : "Sync pending / unavailable")</p>

        <button type="button" @onclick="AuthorizeCurrentTabAsync" class="styled-button">Authorize Tab</button>
        <button type="button" @onclick="RevokeCurrentTabAsync" class="styled-button">Revoke Tab</button>
        <button type="button" @onclick="ClearAuthorizedTabsAsync" class="styled-button">Clear Tabs in This Browser</button>
    </div>

    <hr style="width: 100%; margin: 20px 0;" />

    <div class="popup-form">
        <label>Authorized tabs in this browser (local, including offline):</label>
        @foreach (var tab in authorizedTabs)
        {
            <div style="border-left: 3px solid #2563EB; padding: 4px 8px; margin: 6px 0; font-size: 0.82em; word-break: break-all;">
                [tab @tab.TabId] @tab.Title
            </div>
        }
        <hr />
        <label>Pages available through MCP (@globalTabCount connected):</label>
        @if (!string.IsNullOrEmpty(globalPagesError))
        {
            <p class="error-message" style="font-size: 0.85em;">@globalPagesError</p>
        }
        @if (globalPages.Count == 0 && string.IsNullOrEmpty(globalPagesError))
        {
            <p style="font-size: 0.85em; color: #888;">No pages are currently available through MCP.</p>
        }
        @foreach (var tab in globalPages)
        {
            var isLocal = string.Equals(tab.AgentId, agentId, StringComparison.Ordinal);
            var isActive = isLocal && activeTabId.HasValue && tab.TabId == activeTabId.Value;
            var borderColor = isLocal ? "#2563EB" : "#aaa";
            var browserLabel = tab.BrowserName ?? tab.AgentId;
            <div style="border-left: 3px solid @borderColor; padding: 4px 8px; margin: 6px 0; font-size: 0.82em; word-break: break-all;">
                @if (isActive)
                {
                    <span style="font-weight: bold; color: #2563EB;">[current tab] </span>
                }
                else if (isLocal)
                {
                    <span style="color: #2563EB;">[this browser] </span>
                }
                else
                {
                    <span style="color: #888;">[@browserLabel] </span>
                }
                <span>[tab @tab.TabId] @tab.Title</span><br />
                <span style="color: #666;">@tab.Url</span>
            </div>
        }
    </div>
</div>

@code {
    [Inject] JSInteropService JSInteropService { get; set; } = default!;

    private string connectionError { get; set; } = string.Empty;
    private string serverAddress { get; set; } = "Loading...";
    private string agentId { get; set; } = string.Empty;
    private bool backgroundConnected { get; set; }
    private string connectionStatus { get; set; } = "Disconnected";
    private string syncStatus { get; set; } = "Pending";
    private long localRevision { get; set; }
    private long ackRevision { get; set; } = -1;
    private int? activeTabId;
    private string currentTabSummary { get; set; } = "No active tab.";
    private bool activeTabAuthorized { get; set; }
    private List<BrowserTabDescriptor> authorizedTabs { get; set; } = [];
    private List<GlobalPageInfo> globalPages { get; set; } = [];
    private string globalPagesError { get; set; } = string.Empty;
    private int globalTabCount => globalPages.Count;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await RefreshServerAddressAsync();
        await RefreshActiveTabAsync();
        await RefreshBackgroundStatusAsync();
        await RefreshGlobalPagesAsync();
    }

    private async Task RefreshServerAddressAsync()
    {
        try
        {
            var settings = await JSInteropService.GetExtensionSettingsAsync();
            serverAddress = settings?.ServerAddress ?? string.Empty;
        }
        catch (Exception ex)
        {
            serverAddress = "Unavailable";
            AppendError("Failed to read server settings: " + ex.Message);
        }
    }

    private async Task RefreshActiveTabAsync()
    {
        var activeTab = (await WebExtensions.Tabs.Query(new()
        {
            Active = true,
            CurrentWindow = true
        })).SingleOrDefault();

        activeTabId = activeTab?.Id;

        if (!activeTabId.HasValue)
        {
            currentTabSummary = "No active tab.";
            activeTabAuthorized = false;
            return;
        }

        currentTabSummary = $"[{activeTabId}] {activeTab?.Title}\n{activeTab?.Url}";
        UpdateActiveTabAuthorizationState();
    }

    private async Task RefreshBackgroundStatusAsync()
    {
        var status = await JSInteropService.GetBackgroundAgentStatusAsync();
        ApplyBackgroundStatus(status);
    }

    private async Task RefreshGlobalPagesAsync()
    {
        try
        {
            var result = await JSInteropService.GetGlobalPagesAsync();
            if (result is null || !result.Ok)
            {
                globalPagesError = result?.Error ?? "Failed to load global pages.";
                globalPages = [];
                return;
            }

            globalPagesError = string.Empty;
            globalPages = result.Pages ?? [];
        }
        catch (Exception ex)
        {
            globalPagesError = "Failed to load global pages: " + ex.Message;
            globalPages = [];
        }
    }

    private async Task AuthorizeCurrentTabAsync()
    {
        if (!activeTabId.HasValue)
        {
            AppendError("No active tab is available.");
            return;
        }

        var status = await JSInteropService.AuthorizeTabAsync(activeTabId.Value);
        ApplyBackgroundStatus(status);
        await RefreshGlobalPagesAsync();
    }

    private async Task RevokeCurrentTabAsync()
    {
        if (!activeTabId.HasValue)
        {
            AppendError("No active tab is available.");
            return;
        }

        var status = await JSInteropService.RevokeTabAsync(activeTabId.Value);
        ApplyBackgroundStatus(status);
        await RefreshGlobalPagesAsync();
    }

    private async Task ClearAuthorizedTabsAsync()
    {
        var status = await JSInteropService.ClearAuthorizedTabsAsync();
        ApplyBackgroundStatus(status);
        await RefreshGlobalPagesAsync();
    }

    private void ApplyBackgroundStatus(BackgroundAgentStatus? status)
    {
        if (status is null)
        {
            backgroundConnected = false;
            agentId = string.Empty;
            authorizedTabs = [];
            AppendError("Background agent did not respond.");
            UpdateActiveTabAuthorizationState();
            return;
        }

        backgroundConnected = status.Ok && status.Connected;
        agentId = status.AgentId;
        connectionStatus = status.ConnectionStatus;
        syncStatus = status.SyncStatus;
        localRevision = status.StateRevision;
        ackRevision = status.LastAcknowledgedRevision;
        authorizedTabs = status.AllowedTabs ?? [];

        UpdateActiveTabAuthorizationState();

        if (!status.Ok && !string.IsNullOrWhiteSpace(status.Error))
        {
            AppendError(status.Error);
        }
    }

    private void UpdateActiveTabAuthorizationState()
    {
        activeTabAuthorized = activeTabId.HasValue
            && authorizedTabs.Any(tab => tab.TabId == activeTabId.Value);
    }

    private void AppendError(string message)
    {
        if (string.IsNullOrWhiteSpace(message))
        {
            return;
        }

        connectionError = string.IsNullOrWhiteSpace(connectionError)
            ? message
            : $"{connectionError} {message}";
    }
}
