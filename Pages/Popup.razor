@page "/popup.html"
@inherits BasePage

<h1>Popup Page</h1>

<div>
    <label for="textInput">Enter Text:</label>
    <input id="textInput" @bind="textToSend" placeholder="Type something..." />
</div>

<div>
    <label for="textInput">Enter selector:</label>
    <input id="textInput" @bind="selector" placeholder="Type something..." />
</div>


<button @onclick="ClickFirstButtonOnPage">Send Text</button>

@code {
    [Inject] IJSRuntime JS { get; set; }

    private string textToSend { get; set; }
    private string selector { get; set; } = "div#prompt-textarea[contenteditable=\"true\"]";

    private async Task ClickFirstButtonOnPage()
    {
        await JS.InvokeVoidAsync("executeContentScript", selector, textToSend);
    }
}
