@page "/popup.html"
@inherits BasePage

<div class="popup-container">
    <h1 class="popup-header">Popup Page</h1>

    <form class="popup-form">
        <label for="textInput">Enter Text:</label>
        <input id="textInput" @bind="textToSend" placeholder="Type something..." class="styled-input" />

        <label for="selectorInput">Enter Selector:</label>
        <input id="selectorInput" @bind="selector" placeholder="Type selector..." class="styled-input" />

        <button @onclick="ClickFirstButtonOnPage" class="styled-button">Send Text</button>
    </form>
</div>

@code {
    [Inject] IJSRuntime JS { get; set; }

    private string textToSend { get; set; }
    private string selector { get; set; } = "div#prompt-textarea[contenteditable=\"true\"]";

    private async Task ClickFirstButtonOnPage()
    {
        await JS.InvokeVoidAsync("executeContentScript", selector, textToSend);
    }
}
